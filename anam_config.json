{
  "_comment": "إعدادات ANAM — كلها قيم افتراضية يمكن تعديلها. لا تحتاج أي خدمة مدفوعة.",
  "mode": "normal",
  "github": {
    "enabled": true,
    "queries": [
      "created:>={since} stars:>=10",
      "pushed:>={since} stars:>=50",
      "created:>={since} topic:ai",
      "created:>={since} topic:automation",
      "created:>={since} topic:saas"
    ],
    "per_page": 25,
    "token_env": "GITHUB_TOKEN"
  },
  "npm": {
    "enabled": true,
    "keywords": [
      "ai agent",
      "llm",
      "automation",
      "saas",
      "analytics",
      "trading",
      "rag",
      "workflow"
    ],
    "per_query": 10
  },
  "rss": {
    "enabled": true,
    "feeds": [
      "https://news.ycombinator.com/rss"
    ],
    "max_items_per_feed": 20
  },
  "filters": {
    "normal_min_stars": 500,
    "normal_min_star_velocity_per_day": 25.0,
    "normal_recent_days": 45,
    "npm_min_weekly_downloads": 50000,
    "max_items_full_mode": 300,
    "normal_max_items": 50
  },
  "storage": {
    "db_path": "data/anam.db"
  },
  "reports": {
    "output_dir": "reports",
    "language": "ar"
  },
  "daemon": {
    "interval_minutes": 360
  }
}